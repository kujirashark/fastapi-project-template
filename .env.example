# 应用配置
APP_NAME="FastAPI Blog"
APP_ENV=dev
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# 数据库(本地开发用 docker-compose 里的 mysql 服务)
DB_HOST=mysql
DB_PORT=3306
DB_USER=blog
DB_PASSWORD=blog_pass
DB_ROOT_PASSWORD=root_pass

# 安全配置
SECRET_KEY=change-me-to-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BCRYPT_ROUNDS=12

# 日志
LOG_LEVEL=INFO